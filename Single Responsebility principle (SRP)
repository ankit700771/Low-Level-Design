#include<bits/stdc++.h>
using namespace std;

class Product {
    public:
        string name;
        double price;
        
        Product(string name, double price) {
            this->name = name;
            this->price = price;
        }
};

class ShoppingCard {
    private:
        vector<Product *> products;
        
    public:
    
        void addProducts(Product* p) {
            products.push_back(p);
        }
        
        const vector<Product*>& getProducts() {
            return products;
        }
        
        double calculateTotal() {
            double total = 0;
            
            for(auto p: products) {
                total += p->price;
            }
            
            return total;
        }
        
};

class ShoppingCartPrinter {
    private:
        ShoppingCard *cart;
        
    public:
        
        ShoppingCartPrinter(ShoppingCard* cart) {
            this->cart = cart;
        }
        
        void printInvoice() {
            cout<< "Shopping Cart Invoice: " <<endl;
            
            for(auto p: cart->getProducts()) {
                cout<<p->name<<" - $ "<<p->price<<endl;
            }
            
            cout<<"Total: $"<<cart->calculateTotal() <<endl;
        }
};

class ShoppingCartShorage {
    private:
        ShoppingCard *cart;
    
    public:
        
        ShoppingCartShorage(ShoppingCard *cart) {
            this->cart = cart;
        }
    
        void saveToDb() {
            cout<<"Saving to Database : "<< endl;
        }
};


int main() {
    
    ShoppingCard *cart = new ShoppingCard();
    
    cart->addProducts(new Product("Laptop", 1500));
    cart->addProducts(new Product("Mouse", 50));
    
    ShoppingCartPrinter *printer = new ShoppingCartPrinter(cart);
    printer->printInvoice();
    
    ShoppingCartShorage *storage = new ShoppingCartShorage(cart);
    storage->saveToDb();
    
    
}

















































